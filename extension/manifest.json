{
  "manifest_version": 3,
  "name": "随手回 | SuishouReply",
  "version": "1.2.1",
  "description": "在当前 X 帖子旁生成、编辑中文回复草稿。共用随手回本机 DeepSeek 配置，由你审核、粘贴和发送。",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "clipboardWrite"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": {"service_worker": "src/background.js"},
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["src/post.js", "src/controller.js", "src/panel.js", "src/content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "action": {"default_title": "随手回：在 X 帖子详情页使用", "default_popup": "popup.html"},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"}
}
